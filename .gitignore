# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules

# turbo
.turbo
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# tanstack start
.output/
.tanstack/

# fumadocs collections (regenerated by apps/www's postinstall)
apps/www/.source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug-storybook.log
storybook-static/

# env files (can opt-in for committing if needed)
.env*

# playwright
playwright-report/
playwright-report-*/
test-results/
test-results-*/
blob-report/

# e2e generated config (created by `redemptia init --dev --defaults`)
e2e/.redemptia/
e2e/.auth/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand kit (generated assets)
redemptia-brand-kit.zip
og-default.png

# to remove
prompt_runs.ndjson.gz
prompt_runs_rows.csv
prompt_runs.meta.json

# docker
redemptia.yaml
e2e/artifacts

# retroactive cleanup
# Anchored to the repo root: an unanchored `features/` also matches source
# directories like apps/www/src/routes/ai-visibility-tools/features/.
/features/
.agents/
.cursor/
apps/www/dist/
apps/web/storybook-static/

.claude/settings.local.json
.claude/worktrees/
.readonlydb
.pnpm-store/

# Machine-local agent instructions
CLAUDE.local.md

# Planning notes, kept locally only, except the spec of record
/docs/*
!/docs/SPEC.md
!/docs/EXECUTION-PLAN.md
!/docs/CONSIDERATIONS.md
!/docs/BRANCHING.md

# The model the worker loaded before it judged with Jev; old checkouts may still have it.
apps/worker/mention-judge

# Reports from the staged first run (they hold real answers)
first-contact-*.json
