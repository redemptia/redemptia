{
	"name": "@workspace/worker",
	"version": "0.4.4",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "tsx --env-file=../web/.env src/index.ts",
		"start": "tsx src/index.ts",
		"build": "tsc -p tsconfig.json",
		"check-types": "tsc --noEmit",
		"backfill:run-texts": "tsx --env-file=../web/.env scripts/backfill-run-texts.ts",
		"backfill:run-mentions": "tsx --env-file=../web/.env scripts/backfill-run-mentions.ts",
		"backfill:sentiment": "tsx --env-file=../web/.env scripts/backfill-sentiment.ts",
		"eval:sentiment": "tsx --env-file=../web/.env scripts/eval-sentiment.ts"
	},
	"dependencies": {
		"@sentry/node": "^10.73.0",
		"@workspace/config": "workspace:*",
		"@workspace/deployment": "workspace:*",
		"@workspace/lib": "workspace:*",
		"auth0": "^6.4.0",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1",
		"pg-boss": "^12.37.1",
		"posthog-node": "^5.55.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
